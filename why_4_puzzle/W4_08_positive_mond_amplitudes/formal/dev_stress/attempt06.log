@band_strict_bounds : ∀ {K : Type u_2} [inst : Field K] [inst_1 : LinearOrder K] [IsStrictOrderedRing K] {A L d r : K},
  0 < A →
    0 < L →
      0 < d → 0 ≤ r → r ^ 2 = 1 + d ^ 2 → energy A L d r / 2 < nullStress A L d r ∧ nullStress A L d r < energy A L d r
@pressure_strict_bounds : ∀ {K : Type u_2} [inst : Field K] [inst_1 : LinearOrder K] [IsStrictOrderedRing K]
