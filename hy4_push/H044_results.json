{
  "lane": "H044",
  "pass": 8,
  "fail": 3,
  "results": [
    {
      "check": "S1 [THE CAP IS a_0-FREE] r_cap = D sqrt(M_sat/M_host): the two footings\n      must agree exactly, because a_0 cancels between r_M and g_ext",
      "measured": "|r_cap(f1) - r_cap(f2)|/r_cap = 0.000e+00  (D=100 kpc, M_sat=1e7, M_h=6e10 -> r_cap = 1.2910 kpc)",
      "threshold": "relative difference < 1e-12 (machine agreement)",
      "pass": true
    },
    {
      "check": "S2 [THE MASTER IDENTITY] r_cap/r_M,sat = D/r_M,host over 4 decades of\n      satellite mass and 20-300 kpc: the satellite's own mass cancels",
      "measured": "max |lhs/rhs - 1| over the 16-cell grid = 2.220e-16",
      "threshold": "max relative deviation < 1e-9",
      "pass": true
    },
    {
      "check": "S3 [THE LIMIT] the unified law must reduce to G070's certified isolated\n      line (G M_b a_0)^{1/4}/sqrt(2) when the cap does not bite",
      "measured": "|sigma_law/sigma_iso - 1| at R/r_M = 1e6: f1=5.00e-07  f2=5.00e-07",
      "threshold": "relative deviation < 1e-3 for both footings",
      "pass": true
    },
    {
      "check": "S4 [THE CROSSOVER] the framework does NOT predict blanket suppression:\n      there is a radius D* = 5.408 r_M,host where satellite = field",
      "measured": "D* = f1:51.1 kpc  f2:46.6 kpc  (measured S_M at 20 kpc = 0.486, at 100 kpc = 1.369)",
      "threshold": "S_M(20 kpc) < 1 AND S_M(100 kpc) > 1 (sign must flip)",
      "pass": true
    },
    {
      "check": "S5 [THE SUPPRESSION IS BOUNDED] for an MW-mass host the strongest\n      suppression available to any REAL satellite (innermost is\n      Sagittarius at D ~ 18 kpc) is finite and small",
      "measured": "S_M(18 kpc) = 0.453 (mass) = 0.344 dex, S_sigma = 0.673 = 0.172 dex; absolute floor as D->0: S_M = 0.156 = 0.807 dex, S_sigma = 0.395 = 0.403 dex",
      "threshold": "S_M(18 kpc) > 0.3 (i.e. less than 0.53 dex of suppression)",
      "pass": true
    },
    {
      "check": "S6 [WHERE THE FRAMEWORK SAYS THE CAP IS INERT, IT WORKS] the 8 uncapped\n      satellites must sit on G070's zero-parameter isolated line",
      "measured": "median |log10(sigma_pred/sigma_obs)| = 0.079 dex; median signed = +0.049 dex (n = 8)",
      "threshold": "median |log10| <= 0.15 dex",
      "pass": true
    },
    {
      "check": "S7 [WHERE THE FRAMEWORK SAYS THE CAP BITES, IT FAILS] the 24 capped\n      satellites must ALSO sit within 0.30 dex of the capped prediction",
      "measured": "median log10(sigma_pred/sigma_obs) = -0.487 dex (observed is 3.1x ABOVE prediction); median |log10| = 0.487 dex (n = 24); robust subset (capped even at D+8.3 kpc): n = 21, median = -0.535 dex",
      "threshold": "median |log10(sigma_pred/sigma_obs)| <= 0.30 dex",
      "pass": false
    },
    {
      "check": "S8 [THE DATA PREFER THE TIDE] if truncation were TIDAL rather than\n      smooth-field, almost nothing would be truncated and every object\n      would sit on the isolated line",
      "measured": "tidal prescription: 1/32 capped; EFE prescription: 24/32 capped; median |log10| of the isolated line over the tidal-safe 31 = 0.219 dex",
      "threshold": "<= 3 of 32 tidally capped",
      "pass": true
    },
    {
      "check": "S9 [TOO-BIG-TO-FAIL IS NOT SOLVED BY THE EFE] TBTF needs the satellites\n      to be suppressed by a factor ~2-3 in V_max (0.30-0.50 dex);\n      the EFE must be able to supply that for the classicals",
      "measured": "best suppression available among the 9 classicals = 0.128 dex (Ursa Minor, S_sigma = 0.745); median = -0.000 dex; absolute floor from S5 (D=18 kpc) = 0.172 dex; 5 of 9 have r_cap >= R_1/2 and get exactly 0.000 dex",
      "threshold": "best available suppression >= 0.30 dex",
      "pass": false
    },
    {
      "check": "S10 [MISSING SATELLITES IS NOT ADDRESSED] the missing-satellites problem\n      is a statement about the NUMBER of subhalos; the EFE must change a\n      predicted COUNT, not merely a velocity dispersion",
      "measured": "EFE changes sigma for 24/32 satellites by 0.272 dex and leaves the predicted dark/luminous count ratio at 1.000 (needs >= 10 to even pose the problem, so there is nothing for the EFE to remove)",
      "threshold": "the mechanism must alter a predicted satellite COUNT by >= 2x",
      "pass": false
    },
    {
      "check": "S11 [TESTABLE] the truncation radius lands inside the measured radial\n      range of published dSph dispersion profiles for most of the sample",
      "measured": "r_cap in [0.1, 2] kpc for 30/32 satellites; median r_cap = 58 pc; median r_J/r_cap = 25.6",
      "threshold": ">= 20 of 32 inside the measured radial range",
      "pass": true
    }
  ],
