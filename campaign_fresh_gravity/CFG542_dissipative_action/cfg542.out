  phi_energy_identity: True
  phi_equation: phi_tt + 3H phi_t - c^2 lap phi + V'(phi) = Q/phi_t  (singular where phi_t = 0, i.e. w = -1)
Pb* (slip with flux relaxation alpha tau_ff):
  extended_Lyapunov_identity: True
