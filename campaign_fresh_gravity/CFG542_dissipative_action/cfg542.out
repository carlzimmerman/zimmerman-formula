  Q_discrete: (m12*psi1*(K00*rho1 - K01*rho1 + K01*rho2 + K02*rho3 - K11*rho2 - K12*rho3 + Pb1 - Pb2) - m23*psi3*(K01*rho1 - K02*rho1 + K11*rho2 - K12*rho2 + K12*rho3 - K22*rho3 + Pb2 - Pb3) - psi2*(m12*(K00*rho1 - K01*rho1 + K01*rho2 + K02*rho3 - K11*rho2 - K12*rho3 + Pb1 - Pb2) - m23*(K01*rho1 - K02*rho1 + K11*rho2 - K12*rho2 + K12*rho3 - K22*rho3 + Pb2 - Pb3)))/Theta
  Q_is_mob_dpsi_dPhi: True
  dEdt_exact_zero: True
  dSdt: (m12*psi1**2 - 2*m12*psi1*psi2 + m12*psi2**2 + m23*psi2**2 - 2*m23*psi2*psi3 + m23*psi3**2)/Theta**2
  dSdt_sum_of_squares: True
  mass_conserved: True
  support_free: m_e enter only as nonnegative prefactors of sum-of-squares and of M dE = 0: any support s(x) >= 0 passes
