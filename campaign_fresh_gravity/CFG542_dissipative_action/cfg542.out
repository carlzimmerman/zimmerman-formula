  M3_thermal_shifts_stationarity: True
  M1_noPartner_dEdt: (-m12*(psi1 - psi2)*(K00*rho1 + K01*rho2 + K02*rho3 + Pb1) + m23*(psi2 - psi3)*(K02*rho1 + K12*rho2 + K22*rho3 + Pb3) + (m12*psi1 + m23*psi3 - psi2*(m12 + m23))*(K01*rho1 + K11*rho2 + K12*rho3 + Pb2))/Theta
  M1_noPartner_energy_not_conserved: True
  orbital_dFdt_integrand_outward: 4*pi*dpsi*r**2*rho_c*u
