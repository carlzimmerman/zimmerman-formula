[Ownership] theorem ownership_distinguishes {ι : Type*} (ν : ℝ → ℝ) (a0 : ℝ) (H : Hierarchy ι) {i j p : ι} (hi : H.parent i = none) (hj : H.parent j = some p) {gN : ℝ} (hgN : gN ≠ 0) (hν : ν (gN / a0) ≠ 1) (gext : ℝ) : internalAccel ν a0 H i gN gext ≠ internalAccel ν a0 H j gN gext

