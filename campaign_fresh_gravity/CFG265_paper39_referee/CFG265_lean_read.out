[Theory] theorem ownership_nonlocal {i j p : ι} (hi : B.H.parent i = none) (hj : B.H.parent j = some p) : ¬ ∃ F : ℝ → ℝ → ℝ, ∀ k g ge, B.accel k g ge = F g ge

[Dimension] theorem no_sqrtM_length_GMc : ¬ ∃ a d : ℚ, mono a (1 / 2) d = dLen

[Dimension] theorem sqrtM_length_iff (x : Dim) : (∃ a d e : ℚ, mono a (1 / 2) d + e • x = dLen) ↔ massExp x ≠ 0

[Dimension] theorem acc_from_GcX_iff (x : Dim) : (∃ u v w : ℚ, u • x + v • dG + w • dc = dAcc) ↔ massExp x ≠ 0

[Dimension] theorem sqrtM_length_iff_acc (x : Dim) : (∃ a d e : ℚ, mono a (1 / 2) d + e • x = dLen) ↔ (∃ u v w : ℚ, u • x + v • dG + w • dc = dAcc)

[Dimension] theorem hbar_admissible : mono (3 / 4) (1 / 2) (-7 / 4) + (1 / 4 : ℚ) • dHbar = dLen

[Dimension] theorem not_only_accelerations : ∃ x : Dim, (∃ a d e : ℚ, mono a (1 / 2) d + e • x = dLen) ∧ ¬ ∃ j k : ℚ, x = j • dAcc + k • dc

[Action] theorem gauss_form {μ g gN M ρ : ℝ → ℝ} {G a0 : ℝ} (hEL : ∀ r, 0 < r → HasDerivAt (fun s => s ^ 2 * (μ (g s / a0) * g s)) (G * (4 * Real.pi * r ^ 2 * ρ r)) r) (hN : ∀ r, r ≠ 0 → gN r = G * M r / r ^ 2) (hM : ∀ r, 0 < r → HasDerivAt M (4 * Real.pi * r ^ 2 * ρ r) r) (hreg : Tendsto (fun r => r ^ 2 * (μ (g r / a0) * g r - gN r)) (𝓝[>] 0) (𝓝 0)) : ∀ r, 0 < r → μ (g r / a0) * g r = gN r

[Action] theorem gauss_iff_kernel {a0 gN g : ℝ} (ha : 0 < a0) (hg : 0 < g) (hgN : 0 < gN) : A.μ (g / a0) * g = gN ↔ g = A.nu (gN / a0) * gN

[Action] theorem spherical_kernel {g gN M ρ : ℝ → ℝ} {G a0 : ℝ} (ha : 0 < a0) (hEL : ∀ r, 0 < r → HasDerivAt (fun s => s ^ 2 * (A.μ (g s / a0) * g s)) (G * (4 * Real.pi * r ^ 2 * ρ r)) r) (hN : ∀ r, r ≠ 0 → gN r = G * M r / r ^ 2) (hM : ∀ r, 0 < r → HasDerivAt M (4 * Real.pi * r ^ 2 * ρ r) r) (hreg : Tendsto (fun r => r ^ 2 * (A.μ (g r / a0) * g r - gN r)) (𝓝[>] 0) (𝓝 0)) (hg : ∀ r, 0 < r → 0 < g r) : ∀ r, 0 < r → g r = A.nu (gN r / a0) * gN r

[Action] noncomputable def muP2Aqual : AqualMu

[Action] theorem nuP2_of_action {y : ℝ} (hy : 0 < y) : muP2Aqual.nu y = Real.sqrt (1 + 1 / y)

