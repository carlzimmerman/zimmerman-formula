  },
  "P7 \"gamma <= 1.077 kills the bare law\"": {
   "agrees": false,
   "detail": "1.077 is Arm A (nu_RAR merge) floor minus 3 x 0.028 (a z-rule \"disfavored\" edge, CFG63 \"frozen-rounded\"); the preregistered falsification edge is 1.056; and 1.077 is the TOP of the P2 merge at the variant field, so it cannot kill a P2 bare law"
  },
  "P7 \"gamma >= 1.084 kills B\"": {
   "agrees": true,
   "detail": "1 + 3 x 0.028 = 1.084 (frozen); requires the stability checks (prereg Amdt 13(d))"
  },
  "P7 cap 8.1 and 4,300 pairs": {
   "agrees": true,
   "detail": "cap 8.07, N3 4342 by construction"
  },
  "P8 3.77 sigma": {
   "agrees": true,
   "detail": "3.779"
  },
  "P13 \"ratio up to 2.33 for P2\" (CFG245 on CFG118's spheres)": {
   "agrees": false,
