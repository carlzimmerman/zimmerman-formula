+;-----------------------------------------------------------------------------
+; GDL PORT: accessors for backbone fields used by the parser/pipeline classes
+;-----------------------------------------------------------------------------
+FUNCTION drpBackbone::GDLGet, tag
+  CASE STRUPCASE(tag) OF
+    'MODULES': RETURN, Self.Modules
+    'DATA': RETURN, Self.Data
+    'PARMLIST': RETURN, Self.ParmList
+    'REDUCTIONTYPE': RETURN, Self.ReductionType
+    'LOGPATH': RETURN, Self.LogPath
+    'CURRENTLYEXECUTINGMODULENUMBER': RETURN, Self.CurrentlyExecutingModuleNumber
+  ENDCASE
+END
+
+PRO drpBackbone::GDLSet, tag, value
+  CASE STRUPCASE(tag) OF
+    'MODULES': Self.Modules = value
+    'DATA': Self.Data = value
+    'PARMLIST': Self.ParmList = value
+    'REDUCTIONTYPE': Self.ReductionType = value
+    'LOGPATH': Self.LogPath = value
+    'CURRENTLYEXECUTINGMODULENUMBER': Self.CurrentlyExecutingModuleNumber = value
+  ENDCASE
 END
