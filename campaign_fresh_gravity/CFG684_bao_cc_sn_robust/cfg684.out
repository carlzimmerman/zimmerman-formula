  one_d = np.ones(len(dmu)); Cd1 = one_d@Wd@one_d
  s = np.sqrt(0.02**2 + sl**2); L = np.where(np.isfinite(lsq), np.exp(-0.5*(lsq/s)**2)/s, 0); P = np.exp(-0.5*(chi - chi.min()))*L; P /= P.sum()

