  --- T2a_P2_injective: theorem T2a_P2_injective {f a0 f' a0' g1 g2 : ℝ} (hf : 0 < f) (ha : 0 < a0) (hf' : 0 < f') (ha' : 0 < a0') (hg1 : 0 < g1) (hg2 : 0 < g2) (hne : g1 ≠ g2) (h1 : gObs nuP2 f a0 g1 = gObs nuP2 f' a0' g1) (h2 : gObs nuP2 f a0 g2 = gObs nuP2 f' a0' g2) : f = f' ∧ a0 = a0' := by
  --- T2a_one_point_fails: theorem T2a_one_point_fails {f a0 g : ℝ} (hf : 0 < f) (ha : 0 < a0) (hg : 0 < g) : ∃ f' a0' : ℝ, 0 < f' ∧ 0 < a0' ∧ f' ≠ f ∧ gObs nuP2 f' a0' g = gObs nuP2 f a0 g := by
  --- T2b_deep_not_injective: theorem T2b_deep_not_injective : ∃ f a0 f' a0' : ℝ, 0 < f ∧ 0 < a0 ∧ 0 < f' ∧ 0 < a0' ∧ f ≠ f' ∧ ∀ g : ℝ, 0 < g → gObs nuDeep f a0 g = gObs nuDeep f' a0' g := by
  --- T2c_det_bounds: theorem T2c_det_bounds {y1 y2 : ℝ} (h1 : 0 < y1) (h2 : 0 < y2) : |dlogf y1 * dloga y2 - dloga y1 * dlogf y2| ≤ |y1 - y2| / 2 ∧ |dlogf y1 * dloga y2 - dloga y1 * dlogf y2| ≤ 1 / (2 * (1 + min y1 y2)) ∧ |dlogf y1 * dloga y2 - dloga y1 * dlogf y2| < 1 / 2 := by
  --- T3_newton_limit: theorem T3_newton_limit (ν : ℝ → ℝ) (hν : Tendsto ν atTop (𝓝 1)) {f a0 : ℝ} (hf : 0 < f) (ha : 0 < a0) : Tendsto (fun g : ℝ => gObs ν f a0 g / g) atTop (𝓝 f) := by
  --- T4_design_bound: theorem T4_design_bound {n : ℕ} (b : Fin n → ℝ) (h0 : ∀ i, 0 ≤ b i) (h1 : ∀ i, b i ≤ 1 / 2) : 9 * ∑ i, ∑ j, (b i - b j) ^ 2 ≤ 2 * n * ∑ i, (1 - b i) ^ 2 := by
  --- T4_sigma_floor: theorem T4_sigma_floor {n : ℕ} (hn : 0 < n) {σ : ℝ} (hσ : 0 < σ) (b : Fin n → ℝ) (h0 : ∀ i, 0 ≤ b i) (h1 : ∀ i, b i ≤ 1 / 2) (hdet : 0 < fisher11 σ b * fisher22 σ b - fisher12 σ b ^ 2) : 9 * σ ^ 2 / n ≤ fisher11 σ b / (fisher11 σ b * fisher22 σ b - fisher12 σ b ^ 2) := by
