# Dockerfile for running encore NPCF algorithm
# Provides Linux environment on Mac

FROM ubuntu:22.04

# Install dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    g++ \
    make \
    python3 \
    python3-pip \
    git \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages for data prep
RUN pip3 install numpy astropy scipy

# Create working directory
WORKDIR /work

# Copy encore source
COPY encore/ /work/encore/

# Build encore for CPU (no GPU in container)
WORKDIR /work/encore

# Modify Makefile for CPU-only build
RUN sed -i 's/CXXFLAGS = -O3 -DGPU.*/CXXFLAGS = -O3 -DOPENMP -DFOURPCF -DALLPARITY/' Makefile && \
    sed -i 's/${CUFLAGS}//' Makefile && \
    sed -i 's/CXX = g++.*/CXX = g++ -std=c++0x -ffast-math -fopenmp -Wall/' Makefile

# Build
RUN make clean 2>/dev/null || true
RUN make cpu 2>/dev/null || make encore

# Back to work directory
WORKDIR /work

# Copy analysis scripts
COPY *.py /work/
COPY *.fits /work/ 2>/dev/null || true

# Entry point
CMD ["bash"]
