               0.001     -0.4921          -1.032
                0.01     -0.4754          -1.103
               0.065     -0.4390          -1.278
                 0.2     -0.3965          -1.522
                 0.5     -0.3439          -1.908
                   1     -0.2910          -2.437
                   2     -0.2271          -3.403
                   3     -0.1862          -4.372
                   5     -0.1338          -6.474
                  10     -0.0699         -13.309
                  30     -0.0115         -85.972
