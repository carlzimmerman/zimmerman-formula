  Upsilon_bulge = 0.5: d(offset)/dF = -0.0321, d(offset)/d(bulge) = +0.1184
  Upsilon_bulge = 0.7: d(offset)/dF = -0.0255, d(offset)/d(bulge) = +0.0818
