  "mathematics": {
    "assertion_tested": "On all 21 previously matched MIGHTEE/FASHI/ALFALFA galaxies, compare actual MIGHTEE and ALFALFA profiles with identical frequency-derived velocity windows and residual baseline treatment; test line-wing, baseline and aperture explanations of the flux difference.",
    "coefficient_domain": "float64; frequency MHz; Jy spectral density; velocity relative to MIGHTEE frequency c*(nu_center/nu-1), hence same axis for both instruments; report Jy km/s in this relative convention plus Jy Hz.",
    "conventions": "Integrate native channels by exact overlap of channel frequency-bin edges with common velocity window; no interpolation for flux integrals. Rebin onto common 20 km/s bins only for profile shape plots, preserving overlap integrals. ALFALFA flux is already baseline subtracted: compare residual rebaselining as primary and restoring supplied baseline then fitting same constant/linear rule as sensitivity. MIGHTEE beam arrays handled as CFG302; flag placeholder/invalid beam channels, do not conceal missing coverage.",
    "inputs": [
      "17 extracted paired spectra",
      "21 ALFALFA public FITS spectra",
      "existing catalogue matches"
    ],
    "bounds": {
      "extract_halfwidth_kms": 2200,
      "aperture_beam_multipliers": [
        1.5,
        2.5
      ],
      "line_halfwidth": "max(150,0.5*max(MIGHTEE_W50,ALFALFA_W50)+50) km/s",
      "window_expansions_kms": [
        0,
        100,
        250
      ],
      "baseline_region": "line_halfwidth+350 < abs(v) < 1800 km/s, exclude known other MIGHTEE lines within aperture plus 210 arcsec, with halfwidth=max(150,neighbor_W50/2+100)",
      "baselines": [
        "none",
        "constant clipped median",
        "linear robust clipped fit"
      ],
      "clip_sigma": 3.5,
      "clip_iterations": 4,
      "minimum_baseline_channels": 32,
      "ALFALFA_minimum_weight": 0.5,
      "line_coverage_minimum": 0.95
    },
    "non_claims": [
      "FAST profiles are unavailable publicly and cannot be reconstructed from catalogue fits",
      "Cannot measure absolute calibration or undo upstream continuum subtraction from released cubes",
      "No gravity-law or a0 inference",
      "No universal correction from this small selected overlap"
    ]
  },
