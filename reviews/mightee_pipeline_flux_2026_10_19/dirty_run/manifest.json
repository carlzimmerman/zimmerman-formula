  "mathematics": {
    "assertion_tested": "Compare seven matched central3x3-pixel sightlines in dirty, clean_conv and clean_conv_contsub cubes over common native line channels and sparse identical off-line baseline anchors. This is central brightness localization, not a total-flux comparison.",
    "coefficient_domain": "float64; image Jy/beam, frequency Hz, angular sizes arcsec",
    "conventions": "Same source coordinates, aperture radius (CFG302 line-window beam median times 1.5), frequency channels, beam area and line windows for pre/post stages. Baseline masks and robust constant/linear residual fits follow the previous profile analysis, with common window halfwidth=max(150,max(MIGHTEE W50,ALFALFA W50)/2+50) km/s; expansions0,100,250. Frequency-bin overlap integrals convert JyHz by c/nu_center. Pre means after visibility-domain continuum subtraction, deconvolution, resolution homogenization and mosaicking but before final image-domain subtraction; it is NOT raw visibilities.",
    "inputs": [
      "Seven primary matches from preceding profile comparison",
      "Public clean_conv r1p0 FITS range cutouts",
      "Existing clean_conv_contsub local cubes",
      "Existing ALFALFA spectra and independent catalogue measurements",
      "Heywood et al 2024 sections3.2-3.6 and table2"
    ],
    "bounds": {
      "population": 7,
      "extract_halfwidth_kms": 2200,
      "aperture_beam_multipliers": [
        1.5
      ],
      "download_cap_bytes": 1500000000,
      "concurrent_range_requests": 8,
      "network_timeout_seconds_per_request": 60,
      "maximum_retries": 3,
      "baseline_minimum_channels": 32,
      "line_channels": "all abs(v)<=primary_halfwidth+100",
      "baseline_anchors": "abs(v)>halfwidth+350 and abs(v)<1800, every sixth global channel"
    },
    "non_claims": [
