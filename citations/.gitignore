# API response cache (Crossref / DataCite / arXiv / INSPIRE); rebuilt on demand, never committed
.cache/
# large intermediate extraction products; regenerated by build/extract.py in ~2 minutes
data/texts.json.gz
data/mentions.json.gz
# the repository-wide rules "build/" (build artifacts) and "*hali*" (a private tool) are not meant for this index:
# keep its build code and the pages of people whose names happen to contain "hali" (Khalil, Nathalie, Halicek ...)
!build/
!people/**
!works/**
build/__pycache__/
