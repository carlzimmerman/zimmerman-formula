  J_Y->oo: alpha_1 -> -4*K_B  (pure-EA FJ -4K_B);  alpha_2 -> Piecewise((nan, Eq((1545*K_B + 2906)/(K_B**2 - 4*K_B + 4), 0)), (-oo*(K_B + 1)/((K_B**2 - 4*K_B + 4)*Abs((1545*K_B + 2906)/(K_B**2 - 4*K_B + 4))), True))
  lam2_eff = etaK^2/(2 alpha2 + etaK) = 7500*J_Y**2*(K_B - 2)**3*(J_Y*K_B + 2)**2*(K_B**2 - 4*K_B + 4)/((J_Y + 1)*(7500*J_Y**2*(K_B - 2)**3*(J_Y*K_B + 2)*(K_B**2 - 4*K_B + 4) - (J_Y + 1)*(J_Y*(K_B - 2)**3*(1545*J_Y**3*K_B + 2906*J_Y**3 + 1250*J_Y**2*K_B**3 - 7500*J_Y**2*K_B**2 + 5730*J_Y**2*K_B - 37436*J_Y**2 + 21250*J_Y*K_B**3 - 127500*J_Y*K_B**2 + 121995*J_Y*K_B + 161966*J_Y - 7500*K_B**3 + 45000*K_B**2 - 249270*K_B + 112564) + 15000*K_2*(K_B**2 - 4*K_B + 4)*(-J_Y*K_B**2 + 4*J_Y*K_B + 4))))
