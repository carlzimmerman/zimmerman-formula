        0.010               3.837               4.643
        0.020               2.597               3.379
        0.030               1.606               2.329
        0.050               0.368               0.809
        0.075               0.046               0.116
        0.100               0.010               0.023
        0.150               0.003               0.004
        0.200               0.002               0.003
