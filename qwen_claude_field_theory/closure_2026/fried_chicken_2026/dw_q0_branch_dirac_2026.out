==================================================================================================
  quadratic L_(X,xi) = -gX*gxi + vX*vxi + 4*c*f1*gX**2/a0**2 - 4*c*f1*vX**2/a0**2
  kinetic matrix = [[-8*c*f1/a0**2, 1], [1, 0]]
  inertia (positive, negative, zero) = (1, 1, 0)
  det O(omega,k) = -(k - omega)**2*(k + omega)**2
  det O(omega,0) = -omega**4
