  generalized branch energy = N*(M*c + pX*pxi) + lambda*(-N + vphi**2/N) + pM*vM + plambda*vlambda + pnu*vnu + pphi*vphi - vnu*vphi*(M + f0 - 4*f1*pxi**2/a0**2 + 8*f2*pxi**4/a0**4)/N
