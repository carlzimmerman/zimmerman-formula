  T_11 (generic kernel) = (4*E1**2*FMp + FMval*a0**2)/(8*pi*G)
  MOND kernel: T_00 = a0**2*(y**2*exp(y) - 2*y**2 - 2*y + 2*exp(y) - 2)*exp(-y)/(8*pi*G)  ;  T_zz = a0**2*(-y**2*exp(y) + 2*y**2 + 2*y - 2*exp(y) + 2)*exp(-y)/(8*pi*G)  ;  T_xx = a0**2*(2*y + (y**2 - 2)*exp(y) + 2)*exp(-y)/(8*pi*G)
  [PASS] T_00 = (a0^2/8piG)[2 mu y^2 - G(y)]  (derived, not assumed)
