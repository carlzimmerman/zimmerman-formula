          cutoff u_min =  1e-05:  int_1e-05^oo u^-3 du =   5.0000e+09
          cutoff u_min =  1e-08:  int_1e-08^oo u^-3 du =   5.0000e+15
          cutoff u_min =  1e-11:  int_1e-11^oo u^-3 du =   5.0000e+21
