--- 2.3 THE CANDIDATE LEAN STATEMENTS -- compiling in the mondlean env
statistical_virial (C s2 γ : ℝ) (hC : C ≠ 0) (hs2 : s2 ≠ 0) (hident : γ = C / s2) (hphantom : γ = 2) : s2 = C / 2
statistical_virial_instantiated (G Mb a0 s2 : ℝ) (hG : 0 < G) (hMb : 0 < Mb) (ha0 : 0 < a0) (hs2 : s2 ≠ 0)
  (hident : 2 = √(G * Mb * a0) / s2) : s2 = √(G * Mb * a0) / 2
el_identity_inverse (C s2 γ : ℝ) (hs2 : s2 ≠ 0) (hγ : γ ≠ 0) (hident : γ = C / s2) : s2 = C / γ
el_family_free (C s2 : ℝ) (hs2 : s2 ≠ 0) :
  have γ := C / s2;
  γ * s2 = C
phantom_half_closure (C s2 : ℝ) (hs2 : s2 ≠ 0) (hident : 2 = C / s2) : 2 * s2 = C
'statistical_virial' depends on axioms: [propext, Classical.choice, Quot.sound]
'statistical_virial_instantiated' depends on axioms: [propext, Classical.choice, Quot.sound]
'el_identity_inverse' depends on axioms: [propext, Classical.choice, Quot.sound]
'el_family_free' depends on axioms: [propext, Classical.choice, Quot.sound]
'phantom_half_closure' depends on axioms: [propext, Classical.choice, Quot.sound]

