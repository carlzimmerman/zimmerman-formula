mu2_closed {y : ℝ} (hy : 0 < y) : mu2 y = (y ^ 2 + 2 * y) / (1 + y) ^ 2
g0_pos {y : ℝ} (hy : 0 < y) : 0 < G0 y
j0_negative {y : ℝ} (hy : 0 < y) : J0 y < 0
g0_deriv_eq_mu2 {y : ℝ} (hy : 0 < y) : deriv G0 y = mu2 y
g0_deriv_pos {y : ℝ} (hy : 0 < y) : 0 < deriv G0 y
g0_strict_mono {a b : ℝ} (ha : 0 < a) (h : a < b) : G0 a < G0 b
ratio_negative {c2 KB lam : ℝ} (hc2 : 0 < c2) (hKB : 0 < 2 - KB) (hl : 0 < lam) :
  -(c2 * G0 lam * (2 - KB) / (16 * Real.pi)) < 0
diagnostics_distinct : 1 / 6 ≠ 1 / 2 ∧ 1 / 2 ≠ 4 / 3
'mu2_closed' depends on axioms: [propext, Classical.choice, Quot.sound]
'g0_pos' depends on axioms: [propext, Classical.choice, Quot.sound]
'j0_negative' depends on axioms: [propext, Classical.choice, Quot.sound]
'g0_deriv_eq_mu2' depends on axioms: [propext, Classical.choice, Quot.sound]
'g0_deriv_pos' depends on axioms: [propext, Classical.choice, Quot.sound]
'g0_strict_mono' depends on axioms: [propext, Classical.choice, Quot.sound]
'ratio_negative' depends on axioms: [propext, Classical.choice, Quot.sound]
'diagnostics_distinct' depends on axioms: [propext, Classical.choice, Quot.sound]
