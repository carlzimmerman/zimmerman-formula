AS083_ibp (P : ℝ → ℝ) (a b : ℝ) (hP : DifferentiableOn ℝ P (uIcc a b)) :
  ∫ (x : ℝ) in a..b, 3 * x ^ 2 * P x + x ^ 3 * deriv P x = b ^ 3 * P b - a ^ 3 * P a
AS083_phantom_integral (σ2 A a b : ℝ) (ha : 0 < a) (hb : 0 < b) :
  ∫ (x : ℝ) in a..b, x ^ 2 * (σ2 * A / x ^ 2) = σ2 * A * (b - a)
AS083_surface_algebra (σ2 A a b : ℝ) (ha : a ≠ 0) (hb : b ≠ 0) :
  b ^ 3 * (σ2 * A / b ^ 2) - a ^ 3 * (σ2 * A / a ^ 2) = σ2 * A * (b - a)
AS083_two_boundary_iff (σ2 C A a b : ℝ) (hπ : 0 < Real.pi) (hA : 0 < A) (hd : b - a ≠ 0) :
  12 * Real.pi * σ2 * A * (b - a) = 4 * Real.pi * σ2 * A * (b - a) + 4 * Real.pi * C * A * (b - a) ↔ σ2 = C / 2
AS083_one_boundary_residual (σ2 C A a b : ℝ) (hC : C = 2 * σ2) :
  12 * Real.pi * σ2 * A * (b - a) - (4 * Real.pi * σ2 * A * b + 4 * Real.pi * C * A * (b - a)) =
    -(4 * Real.pi * σ2 * A * a)
AS083_newtonian_cancellation (AGMb a b : ℝ) (ha : a ≠ 0) (hb : b ≠ 0) :
  b ^ 3 * (AGMb / (3 * b ^ 3)) - a ^ 3 * (AGMb / (3 * a ^ 3)) = 0
