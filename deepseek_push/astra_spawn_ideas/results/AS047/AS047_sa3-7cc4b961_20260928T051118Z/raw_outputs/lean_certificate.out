AS047.log_potential_deriv (C r0 : ℝ) (hr : 0 < r0) : deriv (fun r => C * log r) r0 = C / r0
AS047.log_poisson_density (C r0 : ℝ) (hr : 0 < r0) :
  1 / r0 ^ 2 * deriv (fun r => r ^ 2 * deriv (fun s => C * log s) r) r0 = C / r0 ^ 2
AS047.mono_continuation_deriv (c yp ys hstar x : ℝ) (hys : 0 < ys + yp) (hx : 0 < x + yp) :
  deriv (fun y => hstar + c * log ((y + yp) / (ys + yp))) x = c / (x + yp)
