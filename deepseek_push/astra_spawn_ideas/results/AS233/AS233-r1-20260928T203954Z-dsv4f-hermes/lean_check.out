sqrt_series_unit_identity (t : ℝ) :
  (1 + t) * (1 - t / 2 + 3 * t ^ 2 / 8) ^ 2 - 1 = 5 / 8 * t ^ 3 - 15 / 64 * t ^ 4 + 9 / 64 * t ^ 5
alpha1_closed_form_cell : 4 * (3 / 10 + 2 * (1 / 2)) / (2 - 1 / 2) = 52 / 15
alpha1_dictionary_cell (c2t U : ℝ) (hc2 : c2t = 416 * π / 51) (hU : U = 80 * π / 17) : 2 * c2t / U = 52 / 15
negative_control_residual (E : ℝ) (hE : 0 < E) : 4 * (3 / 10 + 2 * (1 / 2)) / (2 - 1 / 2) + 4 * E ≠ 0
