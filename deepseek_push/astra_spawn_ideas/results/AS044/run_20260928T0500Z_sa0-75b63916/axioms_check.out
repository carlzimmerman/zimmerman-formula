AS044.deep_force_at_rM {C G Mb a0 rM : ℝ} (hC : C ^ 2 = G * Mb * a0) (hrM : rM ^ 2 = G * Mb / a0) (hCpos : 0 < C)
  (hrMpos : 0 < rM) (hposa0 : 0 < a0) : C / rM = a0
AS044.newton_force_at_rM {G Mb a0 rM : ℝ} (hrM : rM ^ 2 = G * Mb / a0) (_hpos : 0 < G * Mb) (hposa0 : 0 < a0)
  (hposrM : 0 < rM) : G * Mb / rM ^ 2 = a0
AS044.double_continuity_forces_rM {C G Mb a0 rt rM : ℝ} (hC : C ^ 2 = G * Mb * a0) (hrM : rM ^ 2 = G * Mb / a0)
  (hforce : G * Mb / rt ^ 2 = C / rt) (hpos : 0 < G * Mb) (hposa0 : 0 < a0) (hrt : 0 < rt) : rt ^ 2 = rM ^ 2
AS044.log_rM_over_exp_rM {rM : ℝ} (hrM : 0 < rM) : log (rM / (rexp 1 * rM)) = -1
AS044.potential_continuity {C rM : ℝ} (hrM : 0 < rM) : C * log (rM / (rexp 1 * rM)) = -C
AS044.log_div_pointwise {rM t : ℝ} (ht : 0 < t) (hrM : 0 < rM) : log (t / (rexp 1 * rM)) = log t - log (rexp 1 * rM)
AS044.deep_potential_deriv {C rM r : ℝ} (hr : 0 < r) : HasDerivAt (fun t => C * (log t - log (rexp 1 * rM))) (C / r) r
'AS044.deep_force_at_rM' depends on axioms: [propext, Classical.choice, Quot.sound]
'AS044.newton_force_at_rM' depends on axioms: [propext, Classical.choice, Quot.sound]
'AS044.double_continuity_forces_rM' depends on axioms: [propext, Classical.choice, Quot.sound]
'AS044.log_rM_over_exp_rM' depends on axioms: [propext, Classical.choice, Quot.sound]
'AS044.potential_continuity' depends on axioms: [propext, Classical.choice, Quot.sound]
'AS044.log_div_pointwise' depends on axioms: [propext, Classical.choice, Quot.sound]
'AS044.deep_potential_deriv' depends on axioms: [propext, Classical.choice, Quot.sound]
