=== negative control: density-only moving source ===
C_M (density-only, chi=0) = (6*c2*rho*v + c_N*(S_k*ell - 4)*(M_P2*ac_A*c2*k**2*v - M_P2*ac_chi*c2*k**2 + 2*M_P2*ac_phi*k**2*v + 3*M_P2*ac_psi*c2*k**2*v + 2*M_P2*ac_psi*k**2*v + 2*rho*v) + 8*rho*v)/(4*c_N*(S_k*ell - 4))
fires (nonzero)? True
C_M/(rho k^2 v): (6*c2*rho*v + c_N*(S_k*ell - 4)*(M_P2*ac_A*c2*k**2*v - M_P2*ac_chi*c2*k**2 + 2*M_P2*ac_phi*k**2*v + 3*M_P2*ac_psi*c2*k**2*v + 2*M_P2*ac_psi*k**2*v + 2*rho*v) + 8*rho*v)/(4*c_N*k**2*rho*v*(S_k*ell - 4))
C_H (density-only) = (-S_k*alpha*ell*rho/8 + S_k*c_N*ell*rho/4 + S_k*ell*rho/4 + alpha*rho/2 - c_N*rho + c_N*(S_k*ell - 4)*(-M_P2*S_k*ac_phi*alpha*ell*k**2 + 2*M_P2*S_k*ac_phi*c_N*ell*k**2 + 2*M_P2*S_k*ac_phi*ell*k**2 - 8*M_P2*ac_A*k**2*v**2 + 8*M_P2*ac_chi*k**2*v + 4*M_P2*ac_phi*alpha*k**2 - 8*M_P2*ac_phi*c_N*k**2 - 16*M_P2*ac_phi*k**2 - 24*M_P2*ac_psi*k**2*v**2 - 8*M_P2*ac_psi*k**2 - 8*rho)/16 - 3*rho*(v**2 + 1))/(c_N*(S_k*ell - 4))
=== GR limit check ===
alpha2(alpha=0,c2=0,ell=0) = nan
alpha2(full) = (-M_P2**2*c2**2*k**4*(S_k*alpha*ell - 2*S_k*c_N*ell - 2*S_k*ell - 4*alpha + 8*c_N + 24)*(S_k**2*alpha**2*ell**2 - 4*S_k**2*alpha*c_N*ell**2 - 4*S_k**2*alpha*ell**2 + 4*S_k**2*c_N**2*ell**2 + 8*S_k**2*c_N*ell**2 + 4*S_k**2*ell**2 - 8*S_k*alpha**2*ell + 32*S_k*alpha*c_N*ell + 64*S_k*alpha*ell - 32*S_k*c_N**2*ell - 128*S_k*c_N*ell - 96*S_k*ell + 16*alpha**2 - 64*alpha*c_N - 192*alpha + 64*c_N**2 + 384*c_N + 576) - 8*M_P2*c2**2*k**2*rho*(S_k**2*alpha**2*ell**2 - 4*S_k**2*alpha*c_N*ell**2 - 4*S_k**2*alpha*ell**2 + 4*S_k**2*c_N**2*ell**2 + 8*S_k**2*c_N*ell**2 + 4*S_k**2*ell**2 - 8*S_k*alpha**2*ell + 32*S_k*alpha*c_N*ell + 64*S_k*alpha*ell - 32*S_k*c_N**2*ell - 128*S_k*c_N*ell - 96*S_k*ell + 16*alpha**2 - 64*alpha*c_N - 192*alpha + 64*c_N**2 + 384*c_N + 576) + 16*M_P2*c2*k**2*rho*(S_k*alpha*ell - 2*S_k*c_N*ell - 2*S_k*ell - 4*alpha + 8*c_N + 24)*(S_k*alpha*c2*ell + 2*S_k*alpha*ell - 2*S_k*c2*c_N*ell - 2*S_k*c2*ell - 4*S_k*c_N*ell - 4*S_k*ell - 4*alpha*c2 - 8*alpha + 8*c2*c_N - 12*c2 + 16*c_N + 16) + 2*M_P2*c2*k**2*rho*(-S_k*alpha*ell + 2*S_k*c_N*ell + 2*S_k*ell + 4*alpha + 12*c2 - 8*c_N - 8)*(S_k**2*alpha**2*ell**2 - 4*S_k**2*alpha*c_N*ell**2 - 4*S_k**2*alpha*ell**2 + 4*S_k**2*c_N**2*ell**2 + 8*S_k**2*c_N*ell**2 + 4*S_k**2*ell**2 - 8*S_k*alpha**2*ell + 32*S_k*alpha*c_N*ell + 64*S_k*alpha*ell - 32*S_k*c_N**2*ell - 128*S_k*c_N*ell - 96*S_k*ell + 16*alpha**2 - 64*alpha*c_N - 192*alpha + 64*c_N**2 + 384*c_N + 576) + rho**2*(S_k*alpha*ell - 2*S_k*c_N*ell - 2*S_k*ell - 4*alpha + 8*c_N + 24)*(-S_k**2*alpha**2*ell**2 + 4*S_k**2*alpha*c_N*ell**2 + 4*S_k**2*alpha*ell**2 - 4*S_k**2*c_N**2*ell**2 - 8*S_k**2*c_N*ell**2 - 4*S_k**2*ell**2 + 8*S_k*alpha**2*ell + 24*S_k*alpha*c2*ell - 32*S_k*alpha*c_N*ell - 32*S_k*alpha*ell - 48*S_k*c2*c_N*ell - 48*S_k*c2*ell + 32*S_k*c_N**2*ell + 64*S_k*c_N*ell + 32*S_k*ell - 16*alpha**2 - 96*alpha*c2 + 64*alpha*c_N + 64*alpha - 144*c2**2 + 192*c2*c_N + 192*c2 - 64*c_N**2 - 128*c_N - 64))/(M_P2**2*c2**2*k**2*rho*(S_k*alpha*ell - 2*S_k*c_N*ell - 2*S_k*ell - 4*alpha + 8*c_N + 24)*(S_k**2*alpha**2*ell**2 - 4*S_k**2*alpha*c_N*ell**2 - 4*S_k**2*alpha*ell**2 + 4*S_k**2*c_N**2*ell**2 + 8*S_k**2*c_N*ell**2 + 4*S_k**2*ell**2 - 8*S_k*alpha**2*ell + 32*S_k*alpha*c_N*ell + 64*S_k*alpha*ell - 32*S_k*c_N**2*ell - 128*S_k*c_N*ell - 96*S_k*ell + 16*alpha**2 - 64*alpha*c_N - 192*alpha + 64*c_N**2 + 384*c_N + 576))
