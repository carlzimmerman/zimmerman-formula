⊢ (∫ (u : ℝ) in 0..1,
        u *
          ∫ (x : ℝ) in -√(1 - u ^ 2)..√(1 - u ^ 2),
            u ^ 2 * √(1 - u ^ 2) - u ^ 2 * x + √(1 - u ^ 2) ^ 3 * (1 / 3) + -(x ^ 3 * (1 / 3))) *
      (3 / 2) =
    5 / 12
