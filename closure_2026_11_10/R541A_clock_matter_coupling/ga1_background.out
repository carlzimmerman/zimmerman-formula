# R541A GA1 background + GA5 constraint check
## KA (alpha = 0): record first integral and density
  tau cyclic: True ; p_tau = mu_K**2*(Derivative(tau(t), t) - 1)*a(t)**3/K
  rho_K(alpha=0) on shell = C**2*K/(2*mu_K**2*a(t)**6) + C/a(t)**3   (record: C/a^3 + K C^2/(2 mu_K^2 a^6))  -> True

## First integrals with the couplings (shift symmetry tau -> tau + c survives: L depends on taudot only)
  (i-a) f=Q-1: tau cyclic True; a^3 G'(Q) = p_tau = (-K*alpha*rho_b0 + mu_K**2*(q - 1)*a(t)**3)/K = C (C an integration constant)
  (i-b) f=(Q-1)^2: tau cyclic True; a^3 G'(Q) = p_tau = -(q - 1)*(2*K*alpha*rho_b0 - mu_K**2*a(t)**3)/K = C (C an integration constant)
  (i-c) f=ln Q: tau cyclic True; a^3 G'(Q) = p_tau = (-K*alpha*rho_b0 + mu_K**2*q*(q - 1)*a(t)**3)/(K*q) = C (C an integration constant)

## Energy density (Hamiltonian constraint): rho_tot = Q dG/dQ - G (checked against -dL/dN / a^3)
  (i-a) f=Q-1: rho_tot = (2*K*rho_b*(1 - alpha) + mu_K**2*q**2 - mu_K**2)/(2*K)   (residual vs dL/dN: 0)
  (i-b) f=(Q-1)^2: rho_tot = (2*K*rho_b*(-alpha*q**2 + alpha + 1) + mu_K**2*q**2 - mu_K**2)/(2*K)   (residual vs dL/dN: 0)
  (i-c) f=ln Q: rho_tot = (2*K*rho_b*(alpha*log(q) - alpha + 1) + mu_K**2*q**2 - mu_K**2)/(2*K)   (residual vs dL/dN: 0)

## GA5: Friedmann constraint preserved by the equations (N = 1 gauge), alpha generic, f = Q-1 and ln Q
  (i-a) f=Q-1: H constraint at the point = 2.22E-16; d/dt(constraint) on shell = 1.11022E-15
    KA alpha = 0 (GR + dust + khronon): d/dt(constraint) = 4.44089E-16
  (i-c) f=ln Q: H constraint at the point = 0; d/dt(constraint) on shell = 6.66134E-16
    KA alpha = 0 (GR + dust + khronon): d/dt(constraint) = 0

## Numbers. I0 = 4.037e-8 Mpc^-2 = 2 K rho_d0 (MK1 row 1); K rho_b0 = I0 / (2 R)

