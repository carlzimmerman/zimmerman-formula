# Firebase Configuration
# Copy this file to .env.local and fill in your Firebase project values
# Get these from: Firebase Console > Project Settings > General > Your apps
#
# NOTE: These NEXT_PUBLIC_ values are embedded in the client bundle at build time.
# They are NOT secrets - Firebase client config is designed to be public.
# Security comes from domain restrictions in Google Cloud Console.

NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
