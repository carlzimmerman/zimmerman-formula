   2.36e-14     +0.306        0.87      1.09
   4.17e-14     +0.137        0.38      1.00
   7.36e-14     +0.304        0.45      0.72
   1.30e-13     +0.079        0.77      1.06
   2.29e-13     +0.070        0.29      0.81
   4.04e-13     +0.153        0.07      3.66
