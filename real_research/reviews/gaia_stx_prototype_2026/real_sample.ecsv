#   - {ucd: pos.eq.dec}
#   - {utype: 'stc:AstroCoords.Position2D.Value2.C2'}
# - name: ra_error_systematic
#   unit: mas
#   datatype: float64
#   description: Standard error of right ascension - systematic
#   meta: !!omap
#   - {ucd: stat.error;pos.eq.ra}
#   - {utype: 'stc:AstroCoords.Position2D.Error2.C1'}
