    cell 1: LCDM rho 100 (c_l = 84.29); model b = 5, c = 40 -> rho_m = 45, selected False; retained fraction 0.475
    cell 2: LCDM rho 100 (c_l = 84.29); model b = 49, c = 2 -> rho_m = 51, selected True; retained fraction 0.0237
