    static branch tau = x0, ds^2 = -e^(2 phi) dx0^2 + e^(-2 psi) dx^2:  a_mu = (0, grad phi): True;  K = 0
    N sqrt(h) R^(3) = e^(phi-psi)(2|grad psi|^2 - 4 grad phi.grad psi) + 4 div(e^(phi-psi) grad psi): True
