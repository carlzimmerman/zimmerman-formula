   columns: pid, srcid, root, file, ra, dec, zspec, f444w_aper0.1, mu, Ndup, dup_filenames, use_dG26, lambda_v, beta_UV, M_UV, break_strength, beta_MBB, Teff, peak_wave, logL_MBB, logL_5100, L5100_LMBB, Ha_total_ew, Hb_total_ew, Balmer_dec_total, LHa_total, logLHa_total, OIII_5007_ew, LOIII_5007, logLOIII_5007, LOI_8446, logLOI_8446
