     0.2389- 0.3338    2.116 +/-0.125    0.487 +/-0.027    4.34    +12.8
     0.3338- 0.4663    2.537 +/-0.372    0.574 +/-0.068    4.42     +5.2
     0.4663- 0.6514    2.942 +/-0.398    0.580 +/-0.036    5.08     +5.9
