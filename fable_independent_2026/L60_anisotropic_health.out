    deep MOND, s = 0.01 [alt]              1.098e-11             1.222e-28   2.65e+08 kpc        6.00e-10      6.00e-13
    deep MOND, s = 0.1 [canonical]         2.580e-11             2.871e-28   1.13e+08 kpc        1.41e-09      1.41e-12
    deep MOND, s = 0.1 [alt]               3.109e-11             3.459e-28   9.37e+07 kpc        1.70e-09      1.70e-12
    transition, s = 1 [canonical]          5.075e-11             5.647e-28   5.74e+07 kpc        2.77e-09      2.77e-12
    transition, s = 1 [alt]                6.114e-11             6.803e-28   4.76e+07 kpc        3.34e-09      3.34e-12
    saturated, s = 100 [canonical]         6.061e-11             6.744e-28   4.81e+07 kpc        3.31e-09      3.31e-12
    saturated, s = 100 [alt]               7.302e-11             8.125e-28   3.99e+07 kpc        3.99e-09      3.99e-12
