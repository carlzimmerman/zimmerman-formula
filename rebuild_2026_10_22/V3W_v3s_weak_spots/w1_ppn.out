  D = psi2 - phi2 (particular): m**2/(4*r**2) - 2*m**2*log(r)/L_star**2
  q2 general: C1/L_star**2 + C2/r**2 + C3*r + 3*m**2/(2*pi*G*L_star**2*r) - 2*m**2*r*log(r)/(3*pi*G*L_star**4) + m**2*r**2/(8*pi*G*L_star**6*a0)  (integration constants [C2, C3])
