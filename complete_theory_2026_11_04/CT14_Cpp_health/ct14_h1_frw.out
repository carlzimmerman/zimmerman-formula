  K_zz full (symbolic) = (2*c_Y*k**2 + PX(t)*a(t)**2*v(t)**2 + PXX(t)*a(t)**2*v(t)**4 + Pd1(t)*a(t)**2*u(t)**2 + Pd2(t)*a(t)**2*u(t)**4)*a(t)/(4*H(t)**2)
  det K / (K_phiphi) = (2*c_Y*k**2 + Pd1(t)*a(t)**2*u(t)**2 + Pd2(t)*a(t)**2*u(t)**4)*a(t)/(4*H(t)**2)
  K_zphi (symbolic) = -(PX(t) + PXX(t)*v(t)**2)*a(t)**3*v(t)/(4*H(t))
  K_phiphi (symbolic) = (PX(t) + PXX(t)*v(t)**2)*a(t)**3/4
  (2s)

