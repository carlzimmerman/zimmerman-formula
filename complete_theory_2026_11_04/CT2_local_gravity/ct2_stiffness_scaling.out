p(r) = Piecewise((0**(1/(n - 1))*r**((n - 2)/(n - 1))/3, Eq(lam, 0**(n - 1))), (oo, Eq(n, 4/3)), (r**((n - 2)/(n - 1))*(GM/lam)**(1/(n - 1))*(n - 1)/(3*n - 4), True))
d ln L / d ln M = Piecewise((-1/(n - 2), Ne(n, 4/3) & Ne(lam, 0**(n - 1))), (nan, True))
n giving exponent 1/2: []
 n=1/2: exponent 2/3, F''/lam sign at D>0: -1
 n=3/2: exponent 2, F''/lam sign at D>0: 1
 n=2: exponent zoo, F''/lam sign at D>0: 1
 n=3: exponent -1, F''/lam sign at D>0: 1
log stiffness: p = lam*r**2/(4*GM) ; L = 2*sqrt(GM)*sqrt(a0)/sqrt(lam) ; with lam = k a0^2: L = 2*sqrt(GM)/(sqrt(a0)*sqrt(k))
log stiffness F'' = -lam/D**2 (< 0: concave, longitudinal gradient energy negative)
n=2 control, dp/dr = 0
