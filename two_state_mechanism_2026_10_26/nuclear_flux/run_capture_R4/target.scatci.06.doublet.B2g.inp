&input
  megul = 725, ! input from module CONGEN
  nfte  = 825, ! Hamiltonian scratch file
  nfti  = 16,  ! molecular integrals
/
&cinorn
  name = 'H2+ CI calculation - doublet B2g',
  nstat = 2,  ! number of CI eigenvalues
  nftw = 26,  ! output file with eigenpairs
  nciset = 5, ! index of calculated CI vectors within output file (0 = automatic indexing, but first must be 1)
  igh = 1,    ! force dense diagonalization
/
