&swintfin                 ! used by SW_INTERF (see docs/swinterf)
  name = 'e + H2+ - singlet Ag',
  luamp = 16,             ! orbital amplitudes (moints file)
  luci = 250,             ! inner eigenstates
  mgvn = 0,               ! symmetry, 0 = A1, as in CONGEN
  stot = 1,               ! spin multiplicity 2*S+1
  ntarg = 18,              ! number of target states
  idtarg = 1,5,7,10,15,4,13,3,14,2,6,11,12,18,8,17,9,16              ! mapping of target states from order by target congen inputs to energy order as in unit LUTARG = 24 (output of denprop)
  rmatr = 20.0, ! R-matrix radius
  ismax = 2,              ! maximum multipole to be retained in expansion of long range potentials
/
