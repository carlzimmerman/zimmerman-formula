&input
  name = 'H2+ - Transition Moments',
  ipol = 2, ! controls calculation of dipole polarizabilities, 0 = no calculation
  ntgt = 6, ! number of CSF expansions used, this is the number of different output files to be read
  nftg = 26, ! target eigenstates
  nftint = 16, ! molecular integrals
  nftsor = 720,721,722,724,725,726, ! unit numbers with output from CONGEN
  ntgtf = 1,2,3,4,5,6, ! defines the set number, on unit NFTG where the CI vectors for this symmetry are to be found.
  ntgtl = 5,2,2,5,2,2, ! defines the sequence number, within the set specified by NTGTF, of the last CI vector to be used
  npflg(9) = 1, ! prints computed moments
  zlast = .true., ! when set to .true. identifies that this card deck is the last in the stack of &INPUT decks.
  isw = 1, ! disregard nuclear contribution to transition matrix elements
/
