&state
  sname = 'H2+ - doublet B3g',
  megul = 726, ! unit to which output is saved
  iscat = 1,  ! no phase correction necessary for target
  symtyp = 2, ! D2h, C2v, etc. are of sym. type 2
  qntot  = 2,6,0, ! triplet of numbers, e.g. 1,0,0 means 1 = Singlet, 0 = A1, etc
  nelect = 1, ! number of electrons
  nob  = 235,140,140,138,142,140,140,69, ! total number of orbitals for each symmetry
  nob0 = 5,2,2,0,5,2,2,0, ! number of target orbitals for each symmetry
  nrefo = 1, ! Number of quintets in reforb
  reforb = 6,1,1,0,0, ! reference determinant
  lndo = 10000000, ! memory control
/
&wfngrp
  gname = 'H2+ - doublet B3g',
  qntar = -1,0,0, ! coupling control
  nelecg = 1, ! number of electrons to distribute among configurations
  nrefog = 1, ! number of reference determinants
  reforg = 6,1,1,0,0, ! movable electrons
  ndprod = 1, ! number of sets of shells
  nelecp = 1, ! number of electrons in each set
  nshlp  = 6,  ! number of shells (triplets) in each set
  pqn  = 0,1,5, 0,1,2, 0,1,2, 0,1,5, 0,1,2, 0,1,2, ! orbitals in each shell
  mshl =   0,     1,     2,     4,     5,     6, ! symmetry of shells above 
  npcupf = 1, ! print coupling information
/
